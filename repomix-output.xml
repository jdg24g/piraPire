            </a>
            <button type="submit" class="px-5 py-2 bg-purple-600 hover:bg-purple-500 rounded-xl text-white font-semibold text-sm transition-colors">
                Generar Reporte
            </button>
        </div>
    </form>
</div>

<!-- Resumen Consolidado -->
<div class="grid grid-cols-1 sm:grid-cols-3 gap-6 mb-8">
    <!-- Ingresos Totales -->
    <div class="glass-card p-6 rounded-3xl border border-white/10 shadow-xl flex items-center justify-between">
        <div>
            <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Ingresos Filtrados</span>
            <h3 class="text-2xl font-bold text-emerald-400 mt-1">{{ summary.total_income|gs_format }}</h3>
        </div>
        <div class="p-3 bg-emerald-500/10 rounded-xl text-emerald-400">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/></svg>
        </div>
    </div>
    
    <!-- Gastos Totales -->
    <div class="glass-card p-6 rounded-3xl border border-white/10 shadow-xl flex items-center justify-between">
        <div>
            <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Gastos Filtrados</span>
            <h3 class="text-2xl font-bold text-rose-400 mt-1">{{ summary.total_expense|gs_format }}</h3>
        </div>
        <div class="p-3 bg-rose-500/10 rounded-xl text-rose-400">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 17h8m0 0V9m0 8l-8-8-4 4-6-6"/></svg>
        </div>
    </div>

    <!-- Balance Neto -->
    <div class="glass-card p-6 rounded-3xl border border-white/10 shadow-xl flex items-center justify-between">
        <div>
            <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Balance Neto</span>
            <h3 class="text-2xl font-bold text-white mt-1">
                {{ summary.balance|gs_format }}
            </h3>
        </div>
        <div class="p-3 bg-blue-500/10 rounded-xl text-blue-400">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 002 2h2a2 2 0 002-2z"/></svg>
        </div>
    </div>
</div>

<!-- Gráficos Principales -->
<div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8">
    <!-- Distribución de Gastos -->
    <div class="glass-card p-6 rounded-3xl border border-white/10 shadow-xl">
