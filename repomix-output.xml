            <!-- Grid de Tipo y Moneda -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                <!-- Tipo de Cuenta -->
                <div class="space-y-2">
                    <label for="{{ form.type.id_for_label }}" class="text-sm font-semibold text-slate-300">{{ form.type.label }}</label>
                    {{ form.type }}
                </div>

                <!-- Moneda -->
                <div class="space-y-2">
                    <label for="{{ form.currency.id_for_label }}" class="text-sm font-semibold text-slate-300">{{ form.currency.label }}</label>
                    {{ form.currency }}
                </div>
            </div>

            <!-- Saldo Inicial -->
            <div class="space-y-2">
                <label for="{{ form.initial_balance.id_for_label }}" class="text-sm font-semibold text-slate-300">{{ form.initial_balance.label }}</label>
                {{ form.initial_balance }}
            </div>

            <!-- Activa / Inactiva -->
            <div class="flex items-center gap-3">
                {{ form.is_active }}
                <label for="{{ form.is_active.id_for_label }}" class="text-sm font-semibold text-slate-300">{{ form.is_active.label }}</label>
            </div>

            <div class="flex justify-end gap-3 border-t border-white/5 pt-6">
                <a href="{% url 'wallet_list' %}" class="px-6 py-3 bg-white/5 hover:bg-white/10 rounded-2xl text-slate-300 font-semibold text-sm transition-colors text-center">
                    Cancelar
                </a>
                <button type="submit" class="px-6 py-3 bg-gradient-to-r from-purple-600 to-indigo-600 hover:from-purple-500 hover:to-indigo-500 text-white font-semibold rounded-2xl shadow-lg shadow-indigo-600/30 hover:shadow-indigo-500/40 transform hover:-translate-y-0.5 active:translate-y-0 transition-all duration-200 text-center">
                    Guardar Cambios
                </button>
            </div>
        </form>
    </div>
</div>
{% endblock %}
</file>

<file path="templates/wallets/list.html">
{% extends 'base.html' %}
{% load currency_filters %}

{% block title %}Cuentas - PiraPire{% endblock %}

{% block content %}
<div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-8">
    <div>
        <h1 class="text-3xl font-bold tracking-tight text-white">Mis Cuentas</h1>
        <p class="text-slate-400 mt-1">Administra tus billeteras, cuentas bancarias y tarjetas</p>
    </div>
    
    <a href="{% url 'wallet_create' %}" class="w-full sm:w-auto px-5 py-2.5 bg-gradient-to-r from-purple-600 to-indigo-600 hover:from-purple-500 hover:to-indigo-500 rounded-xl text-white font-semibold text-sm transition-all duration-200 text-center shadow-lg shadow-indigo-600/20">
        + Nueva Cuenta
    </a>
</div>

<!-- Listado de Cuentas (Cards) -->
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
    {% for wallet in wallets %}
    <div class="glass-card rounded-3xl border border-white/10 shadow-xl overflow-hidden flex flex-col justify-between h-56 relative group hover:border-white/20 transition-all duration-300">
        <!-- Efecto de gradiente de fondo según el tipo de cuenta -->
        <div class="absolute inset-0 bg-gradient-to-br 
            {% if wallet.type == 'CASH' %}from-amber-600/10 to-orange-600/10
            {% elif wallet.type == 'BANK' %}from-blue-600/10 to-indigo-600/10
            {% elif wallet.type == 'CREDIT' %}from-rose-600/10 to-purple-600/10
            {% elif wallet.type == 'DEBIT' %}from-emerald-600/10 to-teal-600/10
            {% else %}from-slate-600/10 to-slate-800/10{% endif %} 
            opacity-70 pointer-events-none transition-opacity duration-300 group-hover:opacity-100"></div>

        <!-- Cabecera de la Cuenta -->
        <div class="p-6 relative z-10 flex justify-between items-start">
            <div>
                <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-white/10 text-slate-300">
                    {{ wallet.get_type_display }}
                </span>
                <h3 class="text-xl font-bold text-white mt-3 truncate max-w-[180px]">{{ wallet.name }}</h3>
                <p class="text-xs text-slate-400 mt-0.5">Saldo inicial: {{ wallet.initial_balance|gs_format }}</p>
            </div>
            
            <div class="flex flex-col items-end gap-2">
                <span class="inline-flex h-2.5 w-2.5 rounded-full {% if wallet.is_active %}bg-emerald-400{% else %}bg-slate-500{% endif %}" title="{% if wallet.is_active %}Activa{% else %}Inactiva{% endif %}"></span>
                <span class="text-[10px] text-slate-400 uppercase tracking-wider font-semibold">{{ wallet.currency }}</span>
            </div>
        </div>

        <!-- Footer / Saldo Actual -->
        <div class="p-6 relative z-10 border-t border-white/5 bg-[#0b0f19]/40 flex justify-between items-center">
            <div>
                <p class="text-[10px] text-slate-400 uppercase tracking-wider font-semibold">Saldo Actual</p>
                <h4 class="text-2xl font-black text-white mt-0.5">
                    {{ wallet.current_balance|gs_format }}
                </h4>
            </div>
            
            <a href="{% url 'wallet_edit' wallet.id %}" class="px-3.5 py-1.5 bg-white/10 hover:bg-white/20 border border-white/10 rounded-xl text-white text-xs font-semibold transition-all duration-200">
                Editar
            </a>
        </div>
    </div>
    {% empty %}
    <div class="col-span-full py-12 text-center glass-card rounded-3xl border border-white/10">
        <svg class="w-12 h-12 text-slate-500 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"/></svg>
        <p class="text-slate-400 font-medium">Aún no has registrado ninguna cuenta.</p>
        <a href="{% url 'wallet_create' %}" class="inline-flex items-center gap-2 mt-4 px-4 py-2 bg-purple-600 hover:bg-purple-500 rounded-xl text-white font-semibold text-sm transition-colors">
            Crear mi primera cuenta
        </a>
    </div>
    {% endfor %}
</div>
{% endblock %}
</file>

<file path="templates/base.html">
<!DOCTYPE html>
{% load static %}
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}PiraPire{% endblock %} - Control de Gastos</title>
    
    <link rel="stylesheet" href="{% static 'css/app.css' %}">
    
    <style>
        body {
            font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
            background-color: #0b0f19;
        }
        .glass-card {
            background: rgba(255, 255, 255, 0.06);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.1);
        }
        main[data-page-container] {
            view-transition-name: page-content;
            contain: layout paint;
            min-height: calc(100vh - 2rem);
            overflow-x: clip;
        }
        main[data-page-container].page-enter {
            animation: pira-page-in 180ms cubic-bezier(0.22, 1, 0.36, 1) both;
        }
        html.is-fetching body::after {
            content: "";
            position: fixed;
            top: 0;
            left: 0;
            z-index: 80;
            width: 100%;
            height: 2px;
            background: linear-gradient(90deg, transparent, #a855f7, #6366f1, transparent);
            animation: pira-loading-bar 900ms ease-in-out infinite;
        }
        html.is-transitioning [data-page-container] {
            pointer-events: none;
        }
        ::view-transition-old(root),
        ::view-transition-new(root) {
            animation: none;
        }
        ::view-transition-old(page-content) {
            animation: pira-page-out 120ms ease-out both;
        }
        ::view-transition-new(page-content) {
            animation: pira-page-in 220ms cubic-bezier(0.22, 1, 0.36, 1) both;
        }
        .content-reveal {
            animation: pira-card-enter 260ms cubic-bezier(0.22, 1, 0.36, 1) both;
            animation-delay: var(--reveal-delay, 0ms);
            transform-origin: center top;
        }
        @keyframes pira-loading-bar {
            from {
                transform: translateX(-60%);
            }
            to {
                transform: translateX(60%);
            }
        }
        @keyframes pira-page-out {
            from {
                opacity: 1;
                transform: translateY(0);
            }
            to {
                opacity: 0;
                transform: translateY(-4px);
            }
        }
        @keyframes pira-page-in {
            from {
                opacity: 0;
                transform: translateY(8px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
        @keyframes pira-card-enter {
            from {
                opacity: 0;
                transform: translateY(8px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
        @media (max-width: 767px) {
            .glass-card,
            aside,
            header,
            nav[data-mobile-nav],
            input,
            select,
            textarea {
                backdrop-filter: none !important;
                -webkit-backdrop-filter: none !important;
            }
            ::view-transition-old(page-content) {
                animation: pira-mobile-page-out 110ms ease-out both;
            }
            ::view-transition-new(page-content) {
                animation: pira-mobile-page-up 240ms cubic-bezier(0.22, 1, 0.36, 1) both;
            }
            .content-reveal {
                animation-name: pira-mobile-card-up;
                animation-duration: 280ms;
            }
        }
        @keyframes pira-mobile-page-out {
            from {
                opacity: 1;
                transform: translateY(0);
            }
            to {
                opacity: 0;
                transform: translateY(-6px);
            }
        }
        @keyframes pira-mobile-page-up {
            from {
                opacity: 0;
                transform: translateY(18px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
        @keyframes pira-mobile-card-up {
            from {
                opacity: 0;
                transform: translateY(10px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
        @media (prefers-reduced-motion: reduce) {
            ::view-transition-old(page-content),
            ::view-transition-new(page-content),
            .content-reveal {
                animation-duration: 1ms;
                animation-delay: 0ms;
            }
            main[data-page-container].page-enter {
                animation-duration: 1ms;
            }
            html.is-fetching body::after {
                animation: none;
            }
        }
    </style>
    {% block extra_head %}{% endblock %}
</head>
