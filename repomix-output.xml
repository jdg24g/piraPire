<file path="templates/auth/login.html">
{% extends 'base.html' %}

{% block title %}Iniciar Sesión - PiraPire{% endblock %}

{% block content %}
<div class="relative isolate flex min-h-[calc(100vh-2rem)] flex-col items-center justify-center overflow-hidden px-4 py-8 md:min-h-[calc(100vh-4rem)]">
    <!-- Círculos decorativos traseros para resaltar el glassmorphism -->
    <div class="pointer-events-none absolute left-1/2 top-1/2 -z-10 h-72 w-72 -translate-x-[85%] -translate-y-[75%] rounded-full bg-purple-500/20 blur-3xl"></div>
    <div class="pointer-events-none absolute left-1/2 top-1/2 -z-10 h-72 w-72 -translate-x-[15%] -translate-y-[20%] rounded-full bg-indigo-500/20 blur-3xl"></div>

    <div class="relative z-10 w-full max-w-md rounded-3xl border border-white/10 p-6 shadow-2xl glass-card sm:p-8">
        <div class="text-center mb-8">
            <div class="inline-flex p-3 bg-gradient-to-tr from-purple-500 to-indigo-500 rounded-2xl shadow-lg shadow-indigo-500/20 mb-4">
                <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
            </div>
            <h2 class="text-3xl font-bold bg-gradient-to-r from-white via-slate-100 to-slate-300 bg-clip-text text-transparent">Bienvenido de nuevo</h2>
            <p class="text-slate-400 mt-2 text-sm">Gestiona tus finanzas de forma inteligente</p>
        </div>

        <form method="post" class="space-y-6">
            {% csrf_token %}
            
            {% if form.non_field_errors %}
            <div class="p-3 bg-rose-500/10 border border-rose-500/20 rounded-xl text-rose-400 text-sm">
                {% for error in form.non_field_errors %}
                <p>{{ error }}</p>
                {% endfor %}
            </div>
            {% endif %}

            <div class="space-y-2">
                <label for="id_username" class="text-sm font-semibold text-slate-300">Usuario o correo electrónico</label>
                <div class="relative">
                    <input type="text" name="username" id="id_username" required value="{{ form.username.value|default:'' }}" autocomplete="username" class="w-full px-4 py-3 rounded-2xl bg-white/5 border border-white/10 text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent transition-all duration-300 backdrop-blur-md" placeholder="Ingresa tu usuario">
                </div>
                {% if form.username.errors %}
                <span class="text-xs text-rose-400 font-medium">{{ form.username.errors.0 }}</span>
                {% endif %}
            </div>

            <div class="space-y-2">
                <label for="id_password" class="text-sm font-semibold text-slate-300">Contraseña</label>
                <div class="relative">
                    <input type="password" name="password" id="id_password" required autocomplete="current-password" class="w-full px-4 py-3 rounded-2xl bg-white/5 border border-white/10 text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent transition-all duration-300 backdrop-blur-md" placeholder="••••••••">
                </div>
                {% if form.password.errors %}
                <span class="text-xs text-rose-400 font-medium">{{ form.password.errors.0 }}</span>
                {% endif %}
            </div>

            <button type="submit" class="w-full py-3.5 px-4 bg-gradient-to-r from-purple-600 to-indigo-600 hover:from-purple-500 hover:to-indigo-500 text-white font-semibold rounded-2xl shadow-lg shadow-indigo-600/30 hover:shadow-indigo-500/40 transform hover:-translate-y-0.5 active:translate-y-0 transition-all duration-200">
                Iniciar Sesión
            </button>
        </form>

        <div class="mt-8 text-center border-t border-white/5 pt-6">
            <p class="text-sm text-slate-400">
                ¿No tienes una cuenta? 
                <a href="{% url 'register' %}" class="text-purple-400 hover:text-purple-300 font-semibold transition-all duration-150">Regístrate gratis</a>
            </p>
        </div>
    </div>
</div>
{% endblock %}
</file>

<file path="templates/auth/register.html">
{% extends 'base.html' %}

{% block title %}Crear Cuenta - PiraPire{% endblock %}

{% block content %}
<div class="min-h-[80vh] flex flex-col justify-center items-center px-4 py-8">
    <div class="absolute w-72 h-72 bg-purple-500/20 rounded-full blur-3xl -translate-x-32 -translate-y-20 pointer-events-none"></div>
    <div class="absolute w-72 h-72 bg-indigo-500/20 rounded-full blur-3xl translate-x-32 translate-y-20 pointer-events-none"></div>

    <div class="w-full max-w-md glass-card rounded-3xl border border-white/10 p-8 shadow-2xl relative z-10">
        <div class="text-center mb-8">
            <div class="inline-flex p-3 bg-gradient-to-tr from-purple-500 to-indigo-500 rounded-2xl shadow-lg shadow-indigo-500/20 mb-4">
                <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path>
                </svg>
            </div>
            <h2 class="text-3xl font-bold bg-gradient-to-r from-white via-slate-100 to-slate-300 bg-clip-text text-transparent">Crea tu cuenta</h2>
            <p class="text-slate-400 mt-2 text-sm">Comienza a controlar tus finanzas hoy mismo</p>
        </div>

        <form method="post" class="space-y-5">
            {% csrf_token %}
            
            {% if form.non_field_errors %}
            <div class="p-3 bg-rose-500/10 border border-rose-500/20 rounded-xl text-rose-400 text-sm">
                {% for error in form.non_field_errors %}
                <p>{{ error }}</p>
                {% endfor %}
            </div>
            {% endif %}

            <!-- Campo Usuario -->
            <div class="space-y-1">
                <label for="id_username" class="text-sm font-semibold text-slate-300">Nombre de usuario</label>
                <input type="text" name="username" id="id_username" required value="{{ form.username.value|default:'' }}"
                       class="w-full px-4 py-3 rounded-2xl bg-white/5 border border-white/10 text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent transition-all duration-300 backdrop-blur-md" 
                       placeholder="Ej. minombre">
                {% if form.username.errors %}
                <span class="text-xs text-rose-400 font-medium">{{ form.username.errors.0 }}</span>
                {% endif %}
            </div>

            <!-- Campo Correo -->
            <div class="space-y-1">
                <label for="id_email" class="text-sm font-semibold text-slate-300">Correo electrónico</label>
                <input type="email" name="email" id="id_email" required value="{{ form.email.value|default:'' }}"
                       class="w-full px-4 py-3 rounded-2xl bg-white/5 border border-white/10 text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent transition-all duration-300 backdrop-blur-md" 
                       placeholder="Ej. correo@ejemplo.com">
                {% if form.email.errors %}
                <span class="text-xs text-rose-400 font-medium">{{ form.email.errors.0 }}</span>
                {% endif %}
            </div>

            <!-- Campo Contraseña -->
            <div class="space-y-1">
                <label for="id_password1" class="text-sm font-semibold text-slate-300">Contraseña</label>
                <input type="password" name="password1" id="id_password1" required
                       class="w-full px-4 py-3 rounded-2xl bg-white/5 border border-white/10 text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent transition-all duration-300 backdrop-blur-md" 
                       placeholder="••••••••">
                {% if form.password1.errors %}
                <span class="text-xs text-rose-400 font-medium">{{ form.password1.errors.0 }}</span>
                {% endif %}
            </div>

            <!-- Campo Confirmar Contraseña -->
            <div class="space-y-1">
                <label for="id_password2" class="text-sm font-semibold text-slate-300">Confirmar contraseña</label>
                <input type="password" name="password2" id="id_password2" required
                       class="w-full px-4 py-3 rounded-2xl bg-white/5 border border-white/10 text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent transition-all duration-300 backdrop-blur-md" 
                       placeholder="••••••••">
                {% if form.password2.errors %}
                <span class="text-xs text-rose-400 font-medium">{{ form.password2.errors.0 }}</span>
                {% endif %}
            </div>

            <button type="submit" class="w-full py-3.5 px-4 bg-gradient-to-r from-purple-600 to-indigo-600 hover:from-purple-500 hover:to-indigo-500 text-white font-semibold rounded-2xl shadow-lg shadow-indigo-600/30 hover:shadow-indigo-500/40 transform hover:-translate-y-0.5 active:translate-y-0 transition-all duration-200 mt-2">
                Crear Cuenta
            </button>
        </form>

        <div class="mt-8 text-center border-t border-white/5 pt-6">
            <p class="text-sm text-slate-400">
                ¿Ya tienes una cuenta? 
                <a href="{% url 'login' %}" class="text-purple-400 hover:text-purple-300 font-semibold transition-all duration-150">Inicia sesión</a>
            </p>
        </div>
    </div>
</div>
{% endblock %}
</file>

<file path="templates/categories/form.html">
{% extends 'base.html' %}

{% block title %}{% if object %}Editar Categoría{% else %}Nueva Categoría{% endif %} - PiraPire{% endblock %}

{% block content %}
<div class="max-w-2xl mx-auto py-6">
    <div class="mb-6">
        <a href="{% url 'category_list' %}" class="inline-flex items-center gap-2 text-slate-400 hover:text-white transition-colors text-sm font-semibold mb-2">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
            Volver al listado
        </a>
        <h1 class="text-3xl font-bold tracking-tight text-white">
            {% if object %}Editar Categoría{% else %}Crear Categoría{% endif %}
        </h1>
        <p class="text-slate-400 mt-1">Completa los datos de la categoría</p>
    </div>

    <div class="glass-card p-8 rounded-3xl border border-white/10 shadow-2xl relative">
        <form method="post" class="space-y-6">
            {% csrf_token %}
            
            {% if form.errors %}
            <div class="p-4 bg-rose-500/10 border border-rose-500/20 rounded-xl text-rose-400 text-sm">
                <p class="font-bold mb-1">Por favor corrige los siguientes errores:</p>
                <ul class="list-disc list-inside">
                    {% for field, errors in form.errors.items %}
                    <li><strong>{{ field|capfirst }}:</strong> {{ errors|join:", " }}</li>
                    {% endfor %}
                </ul>
            </div>
            {% endif %}

            <!-- Nombre de la Categoría -->
            <div class="space-y-2">
                <label for="{{ form.name.id_for_label }}" class="text-sm font-semibold text-slate-300">{{ form.name.label }}</label>
                {{ form.name }}
            </div>

            <!-- Grid de Aplica A y Categoría Padre -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                <!-- Aplica A -->
                <div class="space-y-2">
                    <label for="{{ form.applies_to.id_for_label }}" class="text-sm font-semibold text-slate-300">{{ form.applies_to.label }}</label>
                    {{ form.applies_to }}
                </div>

                <!-- Categoría Padre -->
                <div class="space-y-2">
                    <label for="{{ form.parent.id_for_label }}" class="text-sm font-semibold text-slate-300">{{ form.parent.label }}</label>
                    {{ form.parent }}
                </div>
            </div>

            <!-- Activa / Inactiva -->
            <div class="flex items-center gap-3">
                {{ form.is_active }}
                <label for="{{ form.is_active.id_for_label }}" class="text-sm font-semibold text-slate-300">{{ form.is_active.label }}</label>
            </div>

            <div class="flex justify-end gap-3 border-t border-white/5 pt-6">
                <a href="{% url 'category_list' %}" class="px-6 py-3 bg-white/5 hover:bg-white/10 rounded-2xl text-slate-300 font-semibold text-sm transition-colors text-center">
                    Cancelar
                </a>
                <button type="submit" class="px-6 py-3 bg-gradient-to-r from-purple-600 to-indigo-600 hover:from-purple-500 hover:to-indigo-500 text-white font-semibold rounded-2xl shadow-lg shadow-indigo-600/30 hover:shadow-indigo-500/40 transform hover:-translate-y-0.5 active:translate-y-0 transition-all duration-200 text-center">
                    Guardar Cambios
                </button>
            </div>
        </form>
    </div>
</div>
{% endblock %}
</file>

<file path="templates/categories/list.html">
{% extends 'base.html' %}

{% block title %}Categorías - PiraPire{% endblock %}

{% block content %}
<div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-8">
    <div>
        <h1 class="text-3xl font-bold tracking-tight text-white">Categorías</h1>
        <p class="text-slate-400 mt-1">Clasifica tus ingresos y gastos de forma organizada</p>
    </div>
    
    <a href="{% url 'category_create' %}" class="w-full sm:w-auto px-5 py-2.5 bg-gradient-to-r from-purple-600 to-indigo-600 hover:from-purple-500 hover:to-indigo-500 rounded-xl text-white font-semibold text-sm transition-all duration-200 text-center shadow-lg shadow-indigo-600/20">
        + Nueva Categoría
    </a>
</div>

<!-- Grid de Categorías -->
<div class="glass-card p-6 rounded-3xl border border-white/10 shadow-xl">
    <!-- Tabla de Categorías -->
    <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
            <thead>
                <tr class="border-b border-white/5 text-slate-400 text-xs font-semibold uppercase tracking-wider">
                    <th class="py-3 px-4">Nombre</th>
                    <th class="py-3 px-4">Aplica A</th>
                    <th class="py-3 px-4">Categoría Padre</th>
                    <th class="py-3 px-4">Origen</th>
                    <th class="py-3 px-4">Estado</th>
                    <th class="py-3 px-4 text-center">Acciones</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-white/5 text-sm">
                {% for cat in categories %}
                <tr class="hover:bg-white/5 transition-colors">
                    <td class="py-4 px-4 font-bold text-white whitespace-nowrap">{{ cat.name }}</td>
                    <td class="py-4 px-4">
                        <span class="px-2.5 py-1 rounded-lg text-xs font-semibold 
                            {% if cat.applies_to == 'INCOME' %}bg-emerald-500/10 text-emerald-400
                            {% elif cat.applies_to == 'EXPENSE' %}bg-rose-500/10 text-rose-400
                            {% else %}bg-blue-500/10 text-blue-400{% endif %}">
                            {{ cat.get_applies_to_display }}
                        </span>
                    </td>
                    <td class="py-4 px-4 text-slate-400 font-medium">
                        {{ cat.parent.name|default:"—" }}
                    </td>
                    <td class="py-4 px-4">
                        {% if cat.is_default %}
                        <span class="bg-amber-500/10 border border-amber-500/20 text-amber-300 px-2 py-0.5 rounded text-xs font-medium">Predeterminada</span>
                        {% else %}
                        <span class="bg-purple-500/10 border border-purple-500/20 text-purple-300 px-2 py-0.5 rounded text-xs font-medium">Personalizada</span>
                        {% endif %}
                    </td>
                    <td class="py-4 px-4">
                        <span class="inline-flex h-2.5 w-2.5 rounded-full {% if cat.is_active %}bg-emerald-400{% else %}bg-slate-500{% endif %}" title="{% if cat.is_active %}Activa{% else %}Inactiva{% endif %}"></span>
                    </td>
                    <td class="py-4 px-4 text-center whitespace-nowrap">
                        {% if not cat.is_default %}
                        <a href="{% url 'category_edit' cat.id %}" class="text-purple-400 hover:text-purple-300 font-semibold text-xs transition-colors">Editar</a>
                        {% else %}
                        <span class="text-slate-500 text-xs cursor-not-allowed" title="Las categorías predeterminadas del sistema no se pueden editar.">Solo lectura</span>
                        {% endif %}
                    </td>
                </tr>
                {% empty %}
                <tr>
                    <td colspan="6" class="py-6 text-center text-slate-400">No hay categorías configuradas.</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
</file>

<file path="templates/dashboard/index.html">
{% extends 'base.html' %}
{% load currency_filters %}

{% block title %}Dashboard - PiraPire{% endblock %}

{% block content %}
<!-- Cabecera del Dashboard -->
<div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-8">
    <div>
        <h1 class="text-3xl font-bold tracking-tight text-white">Resumen Financiero</h1>
        <p class="text-slate-400 mt-1">Monitorea tus ingresos, gastos y cuotas activas</p>
    </div>
    
    <!-- Filtro de Fecha -->
    <form method="get" class="flex gap-2 w-full md:w-auto">
        <select name="month" class="px-4 py-2 rounded-xl bg-slate-800 border border-white/10 text-white focus:outline-none focus:ring-2 focus:ring-purple-500 text-sm">
            <option value="1" {% if month == 1 %}selected{% endif %}>Enero</option>
            <option value="2" {% if month == 2 %}selected{% endif %}>Febrero</option>
            <option value="3" {% if month == 3 %}selected{% endif %}>Marzo</option>
            <option value="4" {% if month == 4 %}selected{% endif %}>Abril</option>
            <option value="5" {% if month == 5 %}selected{% endif %}>Mayo</option>
            <option value="6" {% if month == 6 %}selected{% endif %}>Junio</option>
            <option value="7" {% if month == 7 %}selected{% endif %}>Julio</option>
            <option value="8" {% if month == 8 %}selected{% endif %}>Agosto</option>
            <option value="9" {% if month == 9 %}selected{% endif %}>Septiembre</option>
            <option value="10" {% if month == 10 %}selected{% endif %}>Octubre</option>
            <option value="11" {% if month == 11 %}selected{% endif %}>Noviembre</option>
            <option value="12" {% if month == 12 %}selected{% endif %}>Diciembre</option>
        </select>
        <select name="year" class="px-4 py-2 rounded-xl bg-slate-800 border border-white/10 text-white focus:outline-none focus:ring-2 focus:ring-purple-500 text-sm">
            <option value="2025" {% if year == 2025 %}selected{% endif %}>2025</option>
            <option value="2026" {% if year == 2026 %}selected{% endif %}>2026</option>
            <option value="2027" {% if year == 2027 %}selected{% endif %}>2027</option>
        </select>
        <button type="submit" class="px-4 py-2 bg-purple-600 hover:bg-purple-500 rounded-xl text-white font-medium text-sm transition-colors">
            Filtrar
        </button>
    </form>
</div>

<!-- Grid de Tarjetas (Cards) Principales -->
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 mb-8">
    
    <!-- Balance -->
    <div class="glass-card p-6 rounded-3xl border border-white/10 shadow-xl flex flex-col justify-between relative overflow-hidden group">
        <div class="absolute top-0 right-0 w-24 h-24 bg-blue-500/10 rounded-full blur-xl pointer-events-none group-hover:scale-150 transition-transform duration-500"></div>
        <div class="flex justify-between items-center mb-4">
            <span class="text-sm font-semibold text-slate-400">Balance del Mes</span>
            <div class="p-2 bg-blue-500/10 rounded-lg text-blue-400">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3"/></svg>
            </div>
        </div>
        <div>
            <h3 class="text-3xl font-bold tracking-tight text-white mb-1">
                {{ data.balance|gs_format }}
            </h3>
            <span class="text-xs font-semibold px-2 py-0.5 rounded-full {% if data.balance >= 0 %}bg-emerald-500/10 text-emerald-400{% else %}bg-rose-500/10 text-rose-400{% endif %}">
                {% if data.balance >= 0 %}Superávit{% else %}Déficit{% endif %}
            </span>
        </div>
    </div>

    <!-- Ingresos del Mes -->
    <div class="glass-card p-6 rounded-3xl border border-white/10 shadow-xl flex flex-col justify-between relative overflow-hidden group">
        <div class="absolute top-0 right-0 w-24 h-24 bg-emerald-500/10 rounded-full blur-xl pointer-events-none group-hover:scale-150 transition-transform duration-500"></div>
        <div class="flex justify-between items-center mb-4">
            <span class="text-sm font-semibold text-slate-400">Ingresos Totales</span>
            <div class="p-2 bg-emerald-500/10 rounded-lg text-emerald-400">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/></svg>
            </div>
        </div>
        <div>
            <h3 class="text-3xl font-bold tracking-tight text-emerald-400 mb-1">{{ data.total_income|gs_format }}</h3>
            <span class="text-xs text-slate-400">Recibidos este período</span>
        </div>
    </div>

    <!-- Gastos del Mes -->
    <div class="glass-card p-6 rounded-3xl border border-white/10 shadow-xl flex flex-col justify-between relative overflow-hidden group">
        <div class="absolute top-0 right-0 w-24 h-24 bg-rose-500/10 rounded-full blur-xl pointer-events-none group-hover:scale-150 transition-transform duration-500"></div>
        <div class="flex justify-between items-center mb-4">
            <span class="text-sm font-semibold text-slate-400">Gastos Totales</span>
            <div class="p-2 bg-rose-500/10 rounded-lg text-rose-400">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 17h8m0 0V9m0 8l-8-8-4 4-6-6"/></svg>
            </div>
        </div>
        <div>
            <h3 class="text-3xl font-bold tracking-tight text-rose-400 mb-1">{{ data.total_expense|gs_format }}</h3>
            <span class="text-xs text-slate-400">Promedio diario: {{ data.daily_expense_average|gs_format }}</span>
        </div>
    </div>

    <!-- Gastos Fijos -->
    <div class="glass-card p-6 rounded-3xl border border-white/10 shadow-xl flex flex-col justify-between">
        <div class="flex justify-between items-center mb-4">
            <span class="text-sm font-semibold text-slate-400">Gastos Fijos</span>
            <div class="p-2 bg-amber-500/10 rounded-lg text-amber-400">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
            </div>
        </div>
        <div>
            <h3 class="text-2xl font-bold text-white mb-1">{{ data.fixed_expenses|gs_format }}</h3>
            <p class="text-xs text-slate-400">Variables Fijos: {{ data.variable_fixed_expenses|gs_format }}</p>
        </div>
    </div>

    <!-- Cuotas del Mes -->
    <div class="glass-card p-6 rounded-3xl border border-white/10 shadow-xl flex flex-col justify-between">
        <div class="flex justify-between items-center mb-4">
            <span class="text-sm font-semibold text-slate-400">Cuotas de este Mes</span>
            <div class="p-2 bg-purple-500/10 rounded-lg text-purple-400">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            </div>
        </div>
        <div>
            <h3 class="text-2xl font-bold text-white mb-1">{{ data.installment_expenses|gs_format }}</h3>
            <span class="text-xs text-slate-400">De compras financiadas</span>
        </div>
    </div>

    <!-- Top Categoría -->
    <div class="glass-card p-6 rounded-3xl border border-white/10 shadow-xl flex flex-col justify-between">
        <div class="flex justify-between items-center mb-4">
            <span class="text-sm font-semibold text-slate-400">Mayor Gasto en</span>
            <div class="p-2 bg-indigo-500/10 rounded-lg text-indigo-400">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
            </div>
        </div>
        <div>
            <h3 class="text-2xl font-bold text-white mb-1 truncate">{{ data.top_expense_category|default:"Sin gastos" }}</h3>
            <span class="text-xs text-slate-400">Cuenta top: {{ data.top_wallet|default:"-" }}</span>
        </div>
    </div>
</div>

<!-- Gráficos -->
<div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8">
    
    <!-- Distribución de Gastos -->
    <div class="glass-card p-6 rounded-3xl border border-white/10 shadow-xl">
        <h3 class="text-lg font-semibold text-white mb-4">Gastos por Categoría</h3>
        <div class="relative h-64 flex justify-center">
            <canvas id="categoryChart"></canvas>
            <div id="noCategoryData" class="hidden absolute inset-0 flex items-center justify-center text-slate-400 text-sm">
                No hay gastos registrados en este mes.
            </div>
        </div>
    </div>

    <!-- Comparativa General -->
    <div class="glass-card p-6 rounded-3xl border border-white/10 shadow-xl">
        <h3 class="text-lg font-semibold text-white mb-4">Ingresos vs Gastos</h3>
        <div class="relative h-64 flex justify-center">
            <canvas id="summaryChart"></canvas>
        </div>
    </div>
</div>

<!-- Últimos Movimientos -->
<div class="glass-card p-6 rounded-3xl border border-white/10 shadow-xl">
    <div class="flex justify-between items-center mb-6">
        <div>
            <h3 class="text-xl font-bold text-white">Últimos Movimientos</h3>
            <p class="text-slate-400 text-xs mt-0.5">Últimas 5 transacciones registradas</p>
        </div>
        <div class="flex gap-2">
            <a href="{% url 'transaction_create' %}?type=EXPENSE" class="px-3.5 py-1.5 bg-rose-500/20 hover:bg-rose-500/30 border border-rose-500/20 rounded-xl text-rose-300 text-xs font-semibold transition-colors">
                + Gasto
            </a>
            <a href="{% url 'transaction_create' %}?type=INCOME" class="px-3.5 py-1.5 bg-emerald-500/20 hover:bg-emerald-500/30 border border-emerald-500/20 rounded-xl text-emerald-300 text-xs font-semibold transition-colors">
                + Ingreso
            </a>
            <a href="{% url 'transaction_list' %}" class="px-3.5 py-1.5 bg-white/5 hover:bg-white/10 border border-white/10 rounded-xl text-slate-300 text-xs font-semibold transition-colors">
                Ver todos
            </a>
        </div>
    </div>

    <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
            <thead>
                <tr class="border-b border-white/5 text-slate-400 text-xs font-semibold uppercase tracking-wider">
                    <th class="py-3 px-4">Fecha</th>
                    <th class="py-3 px-4">Detalle</th>
                    <th class="py-3 px-4">Cuenta</th>
                    <th class="py-3 px-4 text-right">Monto</th>
                    <th class="py-3 px-4 text-center">Acciones</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-white/5 text-sm">
                {% for tx in data.recent_transactions %}
                <tr class="hover:bg-white/5 transition-colors">
                    <td class="py-4 px-4 text-slate-400 font-medium whitespace-nowrap">{{ tx.date }}</td>
                    <td class="py-4 px-4">
                        <div>
                            <p class="font-semibold text-white">{{ tx.description|default:"Sin descripción" }}</p>
                            <span class="text-xs bg-white/10 px-2 py-0.5 rounded text-slate-300">{{ tx.category__name }}</span>
                        </div>
                    </td>
                    <td class="py-4 px-4 text-slate-300">{{ tx.wallet__name }}</td>
                    <td class="py-4 px-4 text-right font-bold whitespace-nowrap {% if tx.type == 'INCOME' %}text-emerald-400{% else %}text-rose-400{% endif %}">
                        {% if tx.type == 'INCOME' %}+{% else %}-{% endif %}{{ tx.amount|gs_format }}
                    </td>
                    <td class="py-4 px-4 text-center whitespace-nowrap">
                        <a href="{% url 'transaction_edit' tx.id %}" class="text-purple-400 hover:text-purple-300 font-semibold text-xs">Editar</a>
                    </td>
                </tr>
                {% empty %}
                <tr>
                    <td colspan="5" class="py-6 text-center text-slate-400">No hay movimientos registrados recientemente.</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>

<script>
    function initDashboardCharts() {
    loadPiraChart().then(() => {
    // Inicialización de Gráficos usando los datos inyectados por Django
    const categoryData = {{ category_expenses_json|safe }};
    const summaryData = {{ summary_json|safe }};
    
    // 1. Gráfico de Categorías
    if (categoryData.length === 0) {
        document.getElementById('noCategoryData').classList.remove('hidden');
        document.getElementById('categoryChart').style.display = 'none';
    } else {
        const catLabels = categoryData.map(item => item.category__name);
        const catTotals = categoryData.map(item => parseFloat(item.total));
        
        new Chart(document.getElementById('categoryChart'), {
            type: 'doughnut',
            data: {
                labels: catLabels,
                datasets: [{
                    data: catTotals,
                    backgroundColor: [
                        '#8b5cf6', '#6366f1', '#3b82f6', '#10b981', '#f59e0b', '#ef4444', '#ec4899'
                    ],
                    borderWidth: 1,
                    borderColor: 'rgba(255, 255, 255, 0.1)'
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        position: 'right',
                        labels: { color: '#cbd5e1', font: { family: 'system-ui', size: 12 } }
                    }
                }
            }
        });
    }

    // 2. Gráfico Resumen Ingresos vs Gastos
    const income = summaryData.total_income || 0;
    const expense = summaryData.total_expense || 0;
    
    new Chart(document.getElementById('summaryChart'), {
        type: 'bar',
        data: {
            labels: ['Ingresos', 'Gastos'],
            datasets: [{
                data: [income, expense],
                backgroundColor: ['#10b981', '#ef4444'],
                borderRadius: 12,
                borderWidth: 0
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: { display: false }
            },
            scales: {
                y: {
                    grid: { color: 'rgba(255, 255, 255, 0.05)' },
                    ticks: { color: '#cbd5e1', font: { family: 'system-ui' } }
                },
                x: {
                    grid: { display: false },
                    ticks: { color: '#cbd5e1', font: { family: 'system-ui', size: 13 } }
                }
            }
        }
    });
    });
    }

    if ('requestIdleCallback' in window) {
        requestIdleCallback(initDashboardCharts, { timeout: 1500 });
    } else {
        setTimeout(initDashboardCharts, 250);
    }
</script>
{% endblock %}
</file>

<file path="templates/installments/form.html">
{% extends 'base.html' %}

{% block title %}{% if object %}Editar Compra en Cuotas{% else %}Nueva Compra en Cuotas{% endif %} - PiraPire{% endblock %}

{% block content %}
<div class="max-w-2xl mx-auto py-6">
    <div class="mb-6">
        <a href="{% url 'installment_list' %}" class="inline-flex items-center gap-2 text-slate-400 hover:text-white transition-colors text-sm font-semibold mb-2">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
            Volver al listado
        </a>
        <h1 class="text-3xl font-bold tracking-tight text-white">
            {% if object %}Editar Compra en Cuotas{% else %}Registrar Compra en Cuotas{% endif %}
        </h1>
        <p class="text-slate-400 mt-1">Completa los datos de la compra financiada</p>
    </div>

    <div class="glass-card p-8 rounded-3xl border border-white/10 shadow-2xl relative">
        <form method="post" class="space-y-6">
            {% csrf_token %}
            
            {% if form.errors %}
            <div class="p-4 bg-rose-500/10 border border-rose-500/20 rounded-xl text-rose-400 text-sm">
                <p class="font-bold mb-1">Por favor corrige los siguientes errores:</p>
                <ul class="list-disc list-inside">
                    {% for field, errors in form.errors.items %}
                    <li><strong>{{ field|capfirst }}:</strong> {{ errors|join:", " }}</li>
                    {% endfor %}
                </ul>
            </div>
            {% endif %}

            <!-- Nombre del Producto/Servicio -->
            <div class="space-y-2">
                <label for="{{ form.product_name.id_for_label }}" class="text-sm font-semibold text-slate-300">{{ form.product_name.label }}</label>
                {{ form.product_name }}
            </div>

            <!-- Grid de Cuenta y Categoría -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                <!-- Cuenta para el Pago -->
                <div class="space-y-2">
                    <label for="{{ form.wallet.id_for_label }}" class="text-sm font-semibold text-slate-300">{{ form.wallet.label }}</label>
                    {{ form.wallet }}
                </div>

                <!-- Categoría -->
                <div class="space-y-2">
                    <label for="{{ form.category.id_for_label }}" class="text-sm font-semibold text-slate-300">{{ form.category.label }}</label>
                    {{ form.category }}
                </div>
            </div>

            <!-- Grid de Monto Total y Cantidad de Cuotas -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                <!-- Monto Total -->
                <div class="space-y-2">
                    <label for="{{ form.total_amount.id_for_label }}" class="text-sm font-semibold text-slate-300">{{ form.total_amount.label }}</label>
                    {{ form.total_amount }}
                </div>

                <!-- Cantidad de Cuotas -->
                <div class="space-y-2">
                    <label for="{{ form.total_installments.id_for_label }}" class="text-sm font-semibold text-slate-300">{{ form.total_installments.label }}</label>
                    {{ form.total_installments }}
                </div>
            </div>

            <!-- Grid de Valor de Cuota y Cuotas Pagadas -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                <!-- Valor de Cuota (Opcional) -->
                <div class="space-y-2">
                    <label for="{{ form.installment_value.id_for_label }}" class="text-sm font-semibold text-slate-300">{{ form.installment_value.label }}</label>
                    {{ form.installment_value }}
                    <span class="text-xs text-slate-400 mt-1 block">Dejar vacío para calcular automáticamente: Monto Total / Cantidad de Cuotas.</span>
                </div>

                <!-- Cuotas Pagadas -->
                <div class="space-y-2">
                    <label for="{{ form.paid_installments.id_for_label }}" class="text-sm font-semibold text-slate-300">{{ form.paid_installments.label }}</label>
                    {{ form.paid_installments }}
                </div>
            </div>

            <!-- Grid de Fecha de Inicio y Estado -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                <!-- Fecha de Inicio -->
                <div class="space-y-2">
                    <label for="{{ form.start_date.id_for_label }}" class="text-sm font-semibold text-slate-300">{{ form.start_date.label }}</label>
                    {{ form.start_date }}
                </div>

                <!-- Estado -->
                <div class="space-y-2">
                    <label for="{{ form.status.id_for_label }}" class="text-sm font-semibold text-slate-300">{{ form.status.label }}</label>
                    {{ form.status }}
                </div>
            </div>

            <div class="flex justify-end gap-3 border-t border-white/5 pt-6">
                <a href="{% url 'installment_list' %}" class="px-6 py-3 bg-white/5 hover:bg-white/10 rounded-2xl text-slate-300 font-semibold text-sm transition-colors text-center">
                    Cancelar
                </a>
                <button type="submit" class="px-6 py-3 bg-gradient-to-r from-purple-600 to-indigo-600 hover:from-purple-500 hover:to-indigo-500 text-white font-semibold rounded-2xl shadow-lg shadow-indigo-600/30 hover:shadow-indigo-500/40 transform hover:-translate-y-0.5 active:translate-y-0 transition-all duration-200 text-center">
                    Guardar Cambios
                </button>
            </div>
        </form>
    </div>
</div>
{% endblock %}
</file>

<file path="templates/installments/list.html">
{% extends 'base.html' %}
{% load currency_filters %}

{% block title %}Compras en Cuotas - PiraPire{% endblock %}

{% block content %}
<div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-8">
    <div>
        <h1 class="text-3xl font-bold tracking-tight text-white">Compras en Cuotas</h1>
        <p class="text-slate-400 mt-1">Monitorea tus pagos financiados a mediano y largo plazo</p>
    </div>
    
    <a href="{% url 'installment_create' %}" class="w-full sm:w-auto px-5 py-2.5 bg-gradient-to-r from-purple-600 to-indigo-600 hover:from-purple-500 hover:to-indigo-500 rounded-xl text-white font-semibold text-sm transition-all duration-200 text-center shadow-lg shadow-indigo-600/20">
        + Registrar Compra
    </a>
</div>

<!-- Listado de Compras en Cuotas -->
<div class="glass-card p-6 rounded-3xl border border-white/10 shadow-xl">
    
    <!-- VISTA MÓVIL (Cards) -->
    <div class="block md:hidden space-y-4">
        {% for inst in installments %}
        <div class="p-4 bg-white/5 rounded-2xl border border-white/5 relative">
            <div class="flex justify-between items-start mb-2">
                <span class="text-xs text-slate-400 font-medium">Inicio: {{ inst.start_date }}</span>
                <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold 
                    {% if inst.status == 'ACTIVE' %}bg-purple-500/15 border border-purple-500/20 text-purple-300
                    {% elif inst.status == 'COMPLETED' %}bg-emerald-500/15 border border-emerald-500/20 text-emerald-300
                    {% else %}bg-slate-500/15 border border-slate-500/20 text-slate-400{% endif %}">
                    {{ inst.get_status_display }}
                </span>
            </div>
            
            <div class="mb-3">
                <h3 class="font-bold text-white text-base truncate">{{ inst.product_name }}</h3>
                <p class="text-xs text-slate-400 mt-0.5">Total: {{ inst.total_amount|gs_format }} | Cuota: {{ inst.installment_value|gs_format }}</p>
                <div class="flex flex-wrap gap-1.5 mt-2">
                    <span class="text-[10px] bg-white/10 px-2 py-0.5 rounded text-slate-300">{{ inst.wallet.name }}</span>
                    <span class="text-[10px] bg-white/10 px-2 py-0.5 rounded text-slate-300">{{ inst.category.name }}</span>
                </div>
            </div>

            <!-- Progreso de Cuotas -->
            <div class="space-y-1.5 mb-4">
                <div class="flex justify-between text-xs font-semibold text-slate-300">
                    <span>Progreso: {{ inst.paid_installments }}/{{ inst.total_installments }} cuotas</span>
                    <span>{{ inst.paid_percentage }}%</span>
                </div>
                <div class="w-full bg-white/10 rounded-full h-2 overflow-hidden">
                    <div class="bg-gradient-to-r from-purple-500 to-indigo-500 h-full rounded-full" style="width: {{ inst.paid_percentage }}%"></div>
                </div>
                <p class="text-[10px] text-slate-400 text-right">Finaliza aprox. en: {{ inst.end_date|default:"—" }}</p>
            </div>

            <div class="flex justify-end border-t border-white/5 pt-2">
                <a href="{% url 'installment_edit' inst.id %}" class="text-purple-400 hover:text-purple-300 font-bold text-xs">
                    Editar Compra
                </a>
            </div>
        </div>
        {% empty %}
        <p class="text-center text-slate-400 py-6 text-sm">No has registrado compras en cuotas todavía.</p>
        {% endfor %}
    </div>

    <!-- VISTA ESCRITORIO (Tabla) -->
    <div class="hidden md:block overflow-x-auto">
        <table class="w-full text-left border-collapse">
            <thead>
                <tr class="border-b border-white/5 text-slate-400 text-xs font-semibold uppercase tracking-wider">
                    <th class="py-3 px-4">Producto/Servicio</th>
                    <th class="py-3 px-4">Cuenta</th>
                    <th class="py-3 px-4">Monto Total</th>
                    <th class="py-3 px-4">Valor Cuota</th>
                    <th class="py-3 px-4">Progreso de Cuotas</th>
                    <th class="py-3 px-4">Finalización</th>
                    <th class="py-3 px-4">Estado</th>
                    <th class="py-3 px-4 text-center">Acciones</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-white/5 text-sm">
                {% for inst in installments %}
                <tr class="hover:bg-white/5 transition-colors">
                    <td class="py-4 px-4 font-bold text-white max-w-xs truncate">{{ inst.product_name }}</td>
                    <td class="py-4 px-4 text-slate-300">{{ inst.wallet.name }}</td>
                    <td class="py-4 px-4 text-white font-semibold">{{ inst.total_amount|gs_format }}</td>
                    <td class="py-4 px-4 text-slate-400">{{ inst.installment_value|gs_format }}</td>
                    <td class="py-4 px-4 min-w-[150px]">
                        <div class="flex items-center gap-3">
                            <span class="text-xs font-semibold text-slate-300 whitespace-nowrap">{{ inst.paid_installments }}/{{ inst.total_installments }}</span>
                            <div class="w-24 bg-white/10 rounded-full h-2 overflow-hidden">
                                <div class="bg-gradient-to-r from-purple-500 to-indigo-500 h-full rounded-full" style="width: {{ inst.paid_percentage }}%"></div>
                            </div>
                            <span class="text-xs font-semibold text-slate-400">{{ inst.paid_percentage }}%</span>
                        </div>
                    </td>
                    <td class="py-4 px-4 text-slate-400 text-xs">{{ inst.end_date|default:"—" }}</td>
                    <td class="py-4 px-4">
                        <span class="px-2 py-0.5 rounded text-xs font-semibold 
                            {% if inst.status == 'ACTIVE' %}bg-purple-500/10 border border-purple-500/20 text-purple-300
                            {% elif inst.status == 'COMPLETED' %}bg-emerald-500/10 border border-emerald-500/20 text-emerald-300
                            {% else %}bg-slate-500/10 border border-slate-500/20 text-slate-400{% endif %}">
                            {{ inst.get_status_display }}
                        </span>
                    </td>
                    <td class="py-4 px-4 text-center whitespace-nowrap">
                        <a href="{% url 'installment_edit' inst.id %}" class="text-purple-400 hover:text-purple-300 font-semibold text-xs transition-colors">Editar</a>
                    </td>
                </tr>
                {% empty %}
                <tr>
                    <td colspan="8" class="py-6 text-center text-slate-400">No has registrado compras en cuotas todavía.</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
</file>

<file path="templates/reports/index.html">
{% extends 'base.html' %}
{% load currency_filters %}

{% block title %}Reportes - PiraPire{% endblock %}

{% block content %}
<div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-8">
    <div>
        <h1 class="text-3xl font-bold tracking-tight text-white">Análisis y Reportes</h1>
        <p class="text-slate-400 mt-1">Visualiza e interpreta la distribución de tu dinero</p>
    </div>
    
    <!-- Botón Exportar CSV -->
    <a href="/api/exports/transactions/csv/?date_from={{ filters.date_from|default:'' }}&date_to={{ filters.date_to|default:'' }}&wallet={{ filters.wallet|default:'' }}&category={{ filters.category|default:'' }}&type={{ filters.type|default:'' }}&subtype={{ filters.subtype|default:'' }}" 
       class="w-full sm:w-auto px-5 py-2.5 bg-slate-800 hover:bg-slate-700 border border-white/10 rounded-xl text-slate-300 font-semibold text-sm transition-colors text-center flex items-center justify-center gap-2 shadow-lg">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
        Exportar CSV Filtrado
    </a>
</div>

<!-- Filtros de Reportes -->
<div class="glass-card p-6 rounded-3xl border border-white/10 shadow-xl mb-8">
    <form method="get" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4">
        <!-- Fecha Desde -->
        <div class="space-y-1">
            <label class="text-xs font-semibold text-slate-400">Fecha Desde</label>
            <input type="date" name="date_from" value="{{ filters.date_from|default:'' }}" class="w-full px-3 py-2 rounded-xl bg-white/5 border border-white/10 text-white focus:outline-none focus:ring-2 focus:ring-purple-500 text-sm">
        </div>
        
        <!-- Fecha Hasta -->
        <div class="space-y-1">
            <label class="text-xs font-semibold text-slate-400">Fecha Hasta</label>
            <input type="date" name="date_to" value="{{ filters.date_to|default:'' }}" class="w-full px-3 py-2 rounded-xl bg-white/5 border border-white/10 text-white focus:outline-none focus:ring-2 focus:ring-purple-500 text-sm">
        </div>

        <!-- Cuenta -->
