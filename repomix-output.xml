                        <span class="bg-purple-500/10 border border-purple-500/20 text-purple-300 px-2.5 py-1 rounded-lg text-xs font-medium">{{ tx.category.name }}</span>
                    </td>
                    <td class="py-4 px-4 text-slate-300 font-medium">{{ tx.wallet.name }}</td>
                    <td class="py-4 px-4 text-slate-400 text-xs">{{ tx.get_subtype_display }}</td>
                    <td class="py-4 px-4 text-right font-bold whitespace-nowrap {% if tx.type == 'INCOME' %}text-emerald-400{% else %}text-rose-400{% endif %}">
                        {% if tx.type == 'INCOME' %}+{% else %}-{% endif %}{{ tx.amount|gs_format }}
                    </td>
                    <td class="py-4 px-4 text-center whitespace-nowrap">
                        <a href="{% url 'transaction_edit' tx.id %}" class="text-purple-400 hover:text-purple-300 font-semibold text-xs transition-colors">Editar</a>
                    </td>
                </tr>
                {% empty %}
                <tr>
                    <td colspan="7" class="py-6 text-center text-slate-400">No se encontraron movimientos con los filtros aplicados.</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    <!-- Paginación -->
    {% if is_paginated %}
    <div class="flex justify-between items-center mt-6 border-t border-white/5 pt-4">
        <span class="text-xs text-slate-400">Página {{ page_obj.number }} de {{ page_obj.paginator.num_pages }}</span>
        <div class="flex gap-2">
            {% if page_obj.has_previous %}
            <a href="?page={{ page_obj.previous_page_number }}&date_from={{ filters.date_from }}&date_to={{ filters.date_to }}&type={{ filters.type }}&wallet={{ filters.wallet }}&category={{ filters.category }}" 
               class="px-3.5 py-1.5 bg-white/5 hover:bg-white/10 rounded-xl text-slate-300 text-xs font-semibold transition-colors">
                Anterior
            </a>
            {% endif %}
            {% if page_obj.has_next %}
            <a href="?page={{ page_obj.next_page_number }}&date_from={{ filters.date_from }}&date_to={{ filters.date_to }}&type={{ filters.type }}&wallet={{ filters.wallet }}&category={{ filters.category }}" 
               class="px-3.5 py-1.5 bg-white/5 hover:bg-white/10 rounded-xl text-slate-300 text-xs font-semibold transition-colors">
                Siguiente
            </a>
            {% endif %}
        </div>
    </div>
    {% endif %}
</div>
{% endblock %}
</file>

