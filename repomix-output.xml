                <option value="">Todos</option>
                <option value="INCOME" {% if filters.type == 'INCOME' %}selected{% endif %}>Ingreso</option>
                <option value="EXPENSE" {% if filters.type == 'EXPENSE' %}selected{% endif %}>Gasto</option>
            </select>
        </div>

        <!-- Cuenta -->
        <div class="space-y-1">
            <label class="text-xs font-semibold text-slate-400">Cuenta</label>
