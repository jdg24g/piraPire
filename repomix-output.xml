            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 002 2h2a2 2 0 002-2z"/></svg>
            <span class="text-[10px] mt-1">Reportes</span>
        </a>
    </nav>
    {% endif %}

    <!-- CONTENEDOR PRINCIPAL -->
    <main class="flex-1 p-4 md:p-8 overflow-y-auto {% if user.is_authenticated %}mb-20 md:mb-0{% endif %} max-w-7xl mx-auto w-full" data-page-container>
        <!-- MENSAJES DJANGO -->
        {% if messages %}
        <div class="mb-6 space-y-2">
            {% for message in messages %}
            <div class="flex items-center justify-between p-4 rounded-xl border {% if message.tags == 'success' %}bg-emerald-500/10 border-emerald-500/20 text-emerald-400{% elif message.tags == 'error' %}bg-rose-500/10 border-rose-500/20 text-rose-400{% else %}bg-blue-500/10 border-blue-500/20 text-blue-400{% endif %} glass-card shadow-lg animate-pulse" id="msg-{{ forloop.counter }}">
                <div class="flex items-center gap-3">
                    <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                    <span class="text-sm font-medium">{{ message }}</span>
                </div>
                <button onclick="document.getElementById('msg-{{ forloop.counter }}').remove()" class="text-slate-400 hover:text-slate-200">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                </button>
            </div>
            {% endfor %}
        </div>
        {% endif %}

        {% block content %}
        {% endblock %}
    </main>

    <script>
        (() => {
            if (window.piraPireTransitionsReady) return;
            window.piraPireTransitionsReady = true;

            const supportsTransitions = 'startViewTransition' in document;
            const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
            const desktopViewport = window.matchMedia('(min-width: 768px)');
            let isNavigating = false;

            function shouldEnhanceNavigation() {
                return !reducedMotion.matches;
            }

            function shouldUseViewTransition() {
                return supportsTransitions && desktopViewport.matches && !reducedMotion.matches;
            }

            function isSkippableUrl(url) {
                return url.origin !== window.location.origin ||
                    url.pathname.startsWith('/api/') ||
                    url.pathname === '/logout/';
            }

            function isSamePageHash(url) {
                return url.pathname === window.location.pathname &&
                    url.search === window.location.search &&
                    url.hash;
            }

            function isCurrentUrl(url) {
                return url.pathname === window.location.pathname &&
                    url.search === window.location.search &&
                    !url.hash;
            }

            function shouldHandleLink(event, link) {
                if (isNavigating || !shouldEnhanceNavigation() || event.defaultPrevented || event.button !== 0) return false;
                if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return false;
                if (link.target && link.target !== '_self') return false;
                if (link.hasAttribute('download') || link.dataset.noTransition !== undefined) return false;

                const url = new URL(link.href, window.location.href);
                return !isSkippableUrl(url) && !isSamePageHash(url) && !isCurrentUrl(url);
            }

            function shouldHandleForm(form) {
                if (isNavigating || !shouldEnhanceNavigation() || form.dataset.noTransition !== undefined) return false;
                const method = (form.method || 'get').toLowerCase();
                const url = new URL(form.action || window.location.href, window.location.href);
                return method === 'get' && !isSkippableUrl(url);
            }

            function runInlineScripts(scope) {
                scope.querySelectorAll('script').forEach(script => {
                    const type = (script.getAttribute('type') || '').trim();
                    if (script.src || (type && !['module', 'text/javascript', 'application/javascript'].includes(type))) {
                        return;
                    }

                    const freshScript = document.createElement('script');
                    freshScript.type = 'module';
                    freshScript.textContent = script.textContent;
                    script.replaceWith(freshScript);
                });
            }

            function dismissMessages(scope = document) {
                setTimeout(() => {
                    scope.querySelectorAll('[id^="msg-"]').forEach(msg => {
                        msg.style.transition = 'opacity 0.5s ease';
                        msg.style.opacity = '0';
                        setTimeout(() => msg.remove(), 500);
                    });
                }, 4000);
            }

            function revealContent(scope = document) {
                if (reducedMotion.matches) return;

                const elements = Array.from(scope.querySelectorAll('.glass-card'));
                elements.forEach((element, index) => {
                    element.classList.remove('content-reveal');
                    element.style.setProperty('--reveal-delay', `${Math.min(index * 28, 140)}ms`);
                });

                requestAnimationFrame(() => {
                    requestAnimationFrame(() => {
                        elements.forEach(element => {
                            element.classList.add('content-reveal');
                        });
                    });
                });
            }

            function syncShellFragment(nextDocument, selector) {
                const current = document.querySelector(selector);
                const next = nextDocument.querySelector(selector);
                if (!current || !next) return;

                current.innerHTML = next.innerHTML;
                current.className = next.className;
            }

            function swapDocument(nextDocument) {
                document.title = nextDocument.title;

                if (document.body.dataset.authenticated !== nextDocument.body.dataset.authenticated) {
                    document.body.innerHTML = nextDocument.body.innerHTML;
                    document.body.dataset.authenticated = nextDocument.body.dataset.authenticated;
                    runInlineScripts(document.body);
                    dismissMessages(document.body);
                    window.scrollTo(0, 0);
                    return;
                }

                const currentMain = document.querySelector('[data-page-container]');
                const nextMain = nextDocument.querySelector('[data-page-container]');
                if (!currentMain || !nextMain) {
                    throw new Error('No se encontró el contenedor principal.');
                }

                currentMain.replaceWith(nextMain);
                syncShellFragment(nextDocument, '[data-desktop-nav]');
                syncShellFragment(nextDocument, '[data-mobile-nav]');
                runInlineScripts(nextMain);
                dismissMessages(nextMain);
                nextMain.classList.add('page-enter');
                nextMain.addEventListener('animationend', () => {
                    nextMain.classList.remove('page-enter');
                }, { once: true });
                window.scrollTo(0, 0);
            }

            async function fetchDocument(url) {
                const response = await fetch(url, {
                    credentials: 'same-origin',
                    headers: { 'X-Requested-With': 'ViewTransition' },
                });

                const contentType = response.headers.get('content-type') || '';
                if (!response.ok || !contentType.includes('text/html')) {
                    throw new Error('La respuesta no es HTML navegable.');
                }

                const html = await response.text();
                return {
                    url: response.url,
                    document: new DOMParser().parseFromString(html, 'text/html'),
                };
            }

            window.loadPiraChart = function loadPiraChart() {
                if (window.Chart) return Promise.resolve(window.Chart);
                if (window.piraChartLoading) return window.piraChartLoading;

                window.piraChartLoading = new Promise((resolve, reject) => {
                    const script = document.createElement('script');
                    script.src = 'https://cdn.jsdelivr.net/npm/chart.js';
                    script.defer = true;
                    script.onload = () => resolve(window.Chart);
                    script.onerror = reject;
                    document.head.appendChild(script);
                });

                return window.piraChartLoading;
            };

            async function navigate(url, shouldPushState = true) {
                isNavigating = true;
                document.documentElement.classList.add('is-fetching');

                try {
                    const next = await fetchDocument(url);
                    document.documentElement.classList.remove('is-fetching');
                    document.documentElement.classList.add('is-transitioning');

                    if (shouldUseViewTransition()) {
                        const transition = document.startViewTransition(() => {
                            swapDocument(next.document);
                        });

                        if (shouldPushState) {
                            history.pushState({}, '', next.url);
                        }

                        await transition.finished;
                    } else {
                        swapDocument(next.document);
                        if (shouldPushState) {
                            history.pushState({}, '', next.url);
                        }
                    }
                } catch (error) {
                    if (shouldPushState) {
                        window.location.href = url;
                    } else {
                        window.location.reload();
                    }
                } finally {
                    isNavigating = false;
                    document.documentElement.classList.remove('is-fetching', 'is-transitioning');
                }
            }

            function activateMobileNavItem(link) {
                if (!link.matches('[data-mobile-nav-item]')) return;

                const nav = link.closest('[data-mobile-nav]');
                if (!nav) return;

                nav.querySelectorAll('[data-mobile-nav-item]').forEach(item => {
                    item.classList.remove('bg-white/10', 'text-purple-400');
                    item.classList.add('text-slate-400');
                });

                link.classList.remove('text-slate-400');
                link.classList.add('bg-white/10', 'text-purple-400');
            }

            document.addEventListener('click', event => {
                const target = event.target instanceof Element ? event.target : null;
                const link = target ? target.closest('a[href]') : null;
                if (!link || !shouldHandleLink(event, link)) return;

                event.preventDefault();
                activateMobileNavItem(link);
                navigate(link.href);
            });

            document.addEventListener('submit', event => {
                const form = event.target;
                if (!(form instanceof HTMLFormElement) || !shouldHandleForm(form)) return;

                event.preventDefault();
                const url = new URL(form.action || window.location.href, window.location.href);
                url.search = new URLSearchParams(new FormData(form)).toString();
                navigate(url.href);
            });

            window.addEventListener('popstate', () => {
                navigate(window.location.href, false);
            });

            dismissMessages();
            revealContent();
        })();
    </script>
</body>
</html>
