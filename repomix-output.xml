        <a href="{% url 'transaction_create' %}?type=EXPENSE" class="flex-1 sm:flex-none px-4 py-2.5 bg-rose-600 hover:bg-rose-500 rounded-xl text-white font-semibold text-sm transition-colors text-center">
            + Gasto
