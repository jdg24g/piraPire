APP_IMAGE_NAME=pirapire
APP_IMAGE_TAG=latest

PIRAPIRE_SECRET_KEY=cambiar_por_una_clave_larga_y_unica
PIRAPIRE_DEBUG=False
PIRAPIRE_ALLOWED_HOSTS=.jdgg.lat,localhost,127.0.0.1,10.0.11.94
PIRAPIRE_CSRF_TRUSTED_ORIGINS=https://*.jdgg.lat,http://localhost:25610,http://127.0.0.1:25610,http://10.0.11.94:25610
PIRAPIRE_CORS_ALLOWED_ORIGINS=http://pirapire.jdgg.lat,https://pirapire.jdgg.lat,http://localhost:25610,http://127.0.0.1:25610,http://10.0.11.94:25610
PIRAPIRE_CORS_ALLOWED_ORIGIN_REGEXES=^https://.*\.jdgg\.lat$
CSRF_COOKIE_SECURE=True
SESSION_COOKIE_SECURE=True
PIRAPIRE_SECURE_SSL_REDIRECT=True
PIRAPIRE_SECURE_HSTS_SECONDS=31536000
PIRAPIRE_SECURE_HSTS_INCLUDE_SUBDOMAINS=True
PIRAPIRE_SECURE_HSTS_PRELOAD=True
PIRAPIRE_TRUST_PROXY_SSL_HEADER=True
PIRAPIRE_TIME_ZONE=America/Asuncion

SERVICE_FQDN_PIRAPIRE=pirapire.jdgg.lat
SERVICE_URL_PIRAPIRE=http://pirapire.jdgg.lat

PIRAPIRE_SERVE_MEDIA=True
PIRAPIRE_SERVE_STATIC=True

PIRAPIRE_SUPERUSER_USERNAME=admin
PIRAPIRE_SUPERUSER_EMAIL=admin@pirapire.local
PIRAPIRE_SUPERUSER_PASSWORD=cambiar_por_password_seguro

# Configuración de base de datos existente
DATABASE_ENGINE=postgres
POSTGRES_DB=postgres
POSTGRES_USER=jdg24g
POSTGRES_PASSWORD=cambiar_por_password_seguro
POSTGRES_HOST=host.docker.internal
POSTGRES_PORT=5432
